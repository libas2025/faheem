# LIBAS TAILOR — Environment Configuration Example
# Copy this file to .env or set these in your production hosting platform (Vercel, Netlify, etc.)

# Public Website URL
VITE_PUBLIC_SITE_URL=https://libastailors.com

# Atelier Notification Email Address
EMAIL_TO=info@libastailors.com

# Verified Sending Email Address
EMAIL_FROM=concierge@libastailors.com

# Transactional Email Provider Secret Key (Resend, SendGrid, etc.)
# Never commit actual production API keys to git!
RESEND_API_KEY=your_resend_api_key_here

# OpenAI API Configuration (Server-Side Only)
# Never expose your OpenAI API key in client-side code!
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Supabase Public Configuration (Safe for browser client)
# Note: NEVER put SUPABASE_SERVICE_ROLE_KEY here or expose it client-side!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
